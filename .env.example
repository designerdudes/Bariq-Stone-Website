# Bariq Stone - Environment Configuration Template
# Copy this file to .env.local and add your production credentials

# Primary notification email where all B2B enquiries will be delivered
NOTIFICATION_EMAIL=info@bariqstone.com

# Verified sender email address (e.g. via Resend or SMTP provider)
EMAIL_FROM=Bariq Stone Export <enquiries@bariqstone.com>

# Resend Email Service API Key (https://resend.com)
# Create a free API key and verify your domain 'bariqstone.com' in Resend DNS settings
RESEND_API_KEY=

# Alternative: SMTP Provider Configuration (if not using Resend)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
